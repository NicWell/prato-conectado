# Escolha api para cadastro/login real, ou mock para testes isolados.
VITE_AUTH_MODE=api
# URL do backend acessível pelo navegador (não nome do serviço Docker).
VITE_API_URL=http://localhost:8000
# Mesmo OAuth Client ID do GOOGLE_CLIENT_ID do backend.
# Não configure Client Secret no frontend.
VITE_GOOGLE_CLIENT_ID=
# Doações e reservas permanecem demonstrativas, mesmo com VITE_AUTH_MODE=api.
VITE_MOCK_MODE=true
